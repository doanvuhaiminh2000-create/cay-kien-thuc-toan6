      <!-- Glossy 3D Highlight -->
      <circle cx="1303.7" cy="608.0" r="52.8" fill="url(#appleGlint)" />
    </g>

    <!-- Apple Em làm chủ AI at (52.0%, 25.0%) -> (998.4, 270.0) -->
    <g filter="url(#appleShad)">
      <!-- Pedicel (stem) -->
      <path d="M 998.4 223.2 Q 1010.4 195.2 1006.4 185.2" fill="none" stroke="#451a03" stroke-width="6" stroke-linecap="round" />
