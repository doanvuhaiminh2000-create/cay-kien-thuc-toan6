      <!-- Top dimple indent -->
      <path d="M 1087.9 569.2 Q 1105.9 581.2 1123.9 569.2" fill="none" stroke="#7f1d1d" stroke-width="4" stroke-linecap="round" opacity="0.8" />
      <!-- Glossy 3D Highlight -->
      <circle cx="1105.9" cy="608.0" r="52.8" fill="url(#appleGlint)" />
    </g>

    <!-- Apple Xác suất thực nghiệm at (67.9%, 56.3%) -> (1303.7, 608.0) -->
    <g filter="url(#appleShad)">
